{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "db:generate": {
      "outputs": ["node_modules/.prisma/client/**"]
    },
    "db:push": {
      "dependsOn": ["db:generate"]
    },
    "db:studio": {
      "cache": false
    },
    "db:seed": {
      "dependsOn": ["db:push"],
      "cache": false
    }
  },
  "globalDependencies": [".env*"],
  "globalEnv": ["DATABASE_URL", "REDIS_URL", "JWT_SECRET", "NEXTAUTH_SECRET"]
}